# Public origin of the website, used for canonical URLs, sitemap and RSS.
SITE_URL=http://localhost:3000

# Base URL of the read-only blog API. When empty, the mock repository is used.
BLOG_API_BASE_URL=

# Optional bearer token for server-to-server blog API access.
BLOG_API_TOKEN=

# Set to 1 to expose the design lab outside development.
DESIGN_LAB=0
